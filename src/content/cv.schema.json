{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cv.schema.json",
  "title": "CV data model",
  "description": "Pure data model for the CV (JSON Resume-inspired). Dates are ISO (YYYY-MM or YYYY-MM-DD), phone is E.164; human-language fields are localized objects with all four locales; all presentation (labels, date formatting, joining) is derived by the UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated",
    "basics",
    "work",
    "holidayJobs",
    "skills",
    "education",
    "certificates",
    "languages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date",
      "description": "Date the CV content last changed (YYYY-MM-DD). Drives JSON-LD dateModified and the sitemap's lastmod."
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "summary",
        "metaDescription",
        "email",
        "phone",
        "url",
        "location",
        "nationality",
        "driversLicense",
        "birth",
        "profiles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/localized",
          "description": "Job title shown after the name"
        },
        "summary": {
          "$ref": "#/$defs/localized",
          "description": "Intro paragraph under the name"
        },
        "metaDescription": {
          "$ref": "#/$defs/localizedMeta",
          "description": "Search-result / social description; kept short enough not to be truncated"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$",
          "description": "E.164, e.g. +32474180683"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "postalCode", "city", "countryCode", "country"],
          "properties": {
            "address": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "countryCode": {
              "type": "string",
              "enum": ["BE"],
              "description": "ISO 3166-1 alpha-2; the localized country name lives in `country`"
            },
            "country": {
              "$ref": "#/$defs/localized"
            }
          }
        },
        "nationality": {
          "$ref": "#/$defs/localized"
        },
        "driversLicense": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AM",
              "A1",
              "A2",
              "A",
              "B",
              "BE",
              "C1",
              "C1E",
              "C",
              "CE",
              "D1",
              "D1E",
              "D",
              "DE",
              "G"
            ],
            "description": "EU driving-licence category"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "birth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place"],
          "properties": {
            "place": {
              "type": "string"
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["network", "url"],
            "properties": {
              "network": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "name", "location", "startDate", "endDate"],
        "properties": {
          "position": {
            "$ref": "#/$defs/localized"
          },
          "name": {
            "type": "string",
            "description": "Company name"
          },
          "location": {
            "$ref": "#/$defs/localized",
            "description": "City"
          },
          "startDate": {
            "$ref": "#/$defs/yearMonth"
          },
          "endDate": {
            "$ref": "#/$defs/yearMonthOrNull",
            "description": "null = present (heden)"
          }
        }
      }
    },
    "holidayJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "companies", "andMore", "startYear", "endYear"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "andMore": {
          "type": "boolean",
          "description": "true renders an ellipsis after the company list"
        },
        "startYear": {
          "$ref": "#/$defs/year"
        },
        "endYear": {
          "$ref": "#/$defs/year"
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "keywords"],
        "properties": {
          "name": {
            "$ref": "#/$defs/localized",
            "description": "Category label, e.g. Frontend"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["studyType", "institution", "institutionGender", "startDate", "endDate"],
        "properties": {
          "studyType": {
            "$ref": "#/$defs/localized"
          },
          "institution": {
            "type": "string"
          },
          "institutionGender": {
            "type": "string",
            "enum": ["m", "f", "n"],
            "description": "Grammatical gender of the institution name's head noun, for languages that decline the preposition (German: an der / am)"
          },
          "startDate": {
            "$ref": "#/$defs/yearMonth"
          },
          "endDate": {
            "$ref": "#/$defs/yearMonthOrNull"
          }
        }
      }
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "date", "issuer"],
        "properties": {
          "name": {
            "$ref": "#/$defs/localized"
          },
          "date": {
            "$ref": "#/$defs/yearMonth"
          },
          "issuer": {
            "$ref": "#/$defs/localized"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "fluency"],
        "properties": {
          "language": {
            "$ref": "#/$defs/localized"
          },
          "fluency": {
            "$ref": "#/$defs/localized"
          }
        }
      }
    }
  },
  "$defs": {
    "year": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "yearMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "yearMonthOrNull": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "null"
        }
      ]
    },
    "localizedMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nl-BE", "en-GB", "fr-BE", "de-BE"],
      "description": "Localized string kept within the ~155 characters search engines show",
      "properties": {
        "nl-BE": { "$ref": "#/$defs/metaString" },
        "en-GB": { "$ref": "#/$defs/metaString" },
        "fr-BE": { "$ref": "#/$defs/metaString" },
        "de-BE": { "$ref": "#/$defs/metaString" }
      }
    },
    "metaString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 155
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nl-BE", "en-GB", "fr-BE", "de-BE"],
      "properties": {
        "nl-BE": {
          "type": "string",
          "minLength": 1
        },
        "en-GB": {
          "type": "string",
          "minLength": 1
        },
        "fr-BE": {
          "type": "string",
          "minLength": 1
        },
        "de-BE": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
