{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "proxy.ts",
    "instrumentation-client.ts",
    "scripts/*.mjs",
    "tests/**/*.{ts,tsx}",
    "*.config.{ts,mjs}"
  ],
  "project": ["src/**", "app/**", "scripts/**", "tests/**"],
  "ignoreBinaries": ["mkcert", "openssl"]
}
