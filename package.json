{
  "name": "cv-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --project=desktop --project=webkit --project=mobile",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test",
    "prepare": "node scripts/images.mjs && node scripts/hooks.mjs",
    "prebuild": "node scripts/clean.mjs && node scripts/images.mjs",
    "images": "node scripts/images.mjs",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "sizes": "node scripts/sizes.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
